#!/usr/bin/env node
"use strict";

const childProcess = require("child_process");
const fs = require("fs");
const path = require("path");

const serverDir = __dirname;
const CONFIG_FILE = "start-dev-config";

// Shares start-dev's config so the repos don't have to be siblings, but stays usable without it.
function resolveClientDir() {
	const configPath = path.join(serverDir, CONFIG_FILE);
	if (fs.existsSync(configPath)) {
		const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
		if (config.clientDir) return path.resolve(serverDir, config.clientDir);
	}
	return path.resolve(serverDir, "../pokemon-showdown-client");
}

const clientDir = resolveClientDir();
const pidFile = path.join(serverDir, ".start-analysis.pids.json");
const apiPort = 8002;
const clientPort = 8081;
const analysisUrl = `http://localhost:${clientPort}/analysis.pokemonshowdown.com/?~~localhost:${apiPort}`;

function killPid(pid, label) {
	try {
		process.kill(pid, "SIGTERM");
		console.log(`Stopped ${label} (pid ${pid})`);
	} catch (error) {
		if (error.code !== "ESRCH") console.warn(`Could not stop ${label}: ${error.message}`);
	}
}

function killPort(port) {
	try {
		const output = childProcess.execFileSync("lsof", ["-ti", `TCP:${port}`, "-sTCP:LISTEN"], { encoding: "utf8" });
		for (const pid of output.trim().split(/\s+/).filter(Boolean)) killPid(Number(pid), `port ${port}`);
	} catch (error) {
		if (error.status !== 1) throw error;
	}
}

function stopPrevious() {
	if (fs.existsSync(pidFile)) {
		const { pids } = JSON.parse(fs.readFileSync(pidFile, "utf8"));
		for (const entry of pids || []) killPid(entry.pid, entry.label);
		fs.unlinkSync(pidFile);
	}
	killPort(apiPort);
	killPort(clientPort);
}

function openInBrowser(url) {
	if (process.platform === "darwin") {
		childProcess.execSync(`open ${JSON.stringify(url)}`);
	} else if (process.platform === "win32") {
		childProcess.execSync(`start ${JSON.stringify(url)}`, { shell: true });
	} else {
		childProcess.execSync(`xdg-open ${JSON.stringify(url)}`);
	}
}

function start(label, command, args, cwd, env = process.env) {
	const child = childProcess.spawn(command, args, { cwd, env, detached: true, stdio: "ignore" });
	child.unref();
	console.log(`Started ${label} (pid ${child.pid})`);
	return { label, pid: child.pid };
}

function main() {
	stopPrevious();
	if (process.argv.includes("--kill")) return;

	if (!fs.existsSync(clientDir)) {
		throw new Error(`Client directory not found: ${clientDir}\nSet clientDir in ${CONFIG_FILE} (see ${CONFIG_FILE}.example).`);
	}

	// Neither repo is built here: run `npm run build` yourself after changing server or client code.
	const apiEntry = path.join(serverDir, "dist", "tools", "analysis-server.js");
	if (!fs.existsSync(apiEntry)) {
		throw new Error(`Analysis API not built: ${apiEntry}\nRun \`npm run build\` in ${serverDir}.`);
	}
	const clientEntry = path.join(clientDir, "analysis.pokemonshowdown.com", "index.html");
	if (!fs.existsSync(clientEntry)) {
		throw new Error(`Analysis client not built: ${clientEntry}\nRun \`npm run build\` in ${clientDir}.`);
	}

	const pids = [
		start("analysis-api", "node", ["dist/tools/analysis-server.js"], serverDir, {
			...process.env,
			ANALYSIS_PORT: String(apiPort),
		}),
		start("analysis-client", "npx", ["http-server", "-p", String(clientPort), "."], clientDir),
	];
	fs.writeFileSync(pidFile, JSON.stringify({ startedAt: new Date().toISOString(), pids }, null, "\t"));

	console.log("\nWaiting for servers to come up...");
	setTimeout(() => {
		console.log(`Opening Analysis at ${analysisUrl}`);
		openInBrowser(analysisUrl);
		console.log("Stop with: node start-analysis --kill");
	}, 3000);
}

try {
	main();
} catch (error) {
	console.error(error.stack || error);
	process.exit(1);
}